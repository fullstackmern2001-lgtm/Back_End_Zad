# PayPal Business account country: Jordan (JO)
# Buyers: all countries where PayPal and the merchant account support payments
# Use the PayPal Developer Dashboard application credentials for each environment.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_SANDBOX_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_SANDBOX_CLIENT_SECRET=replace-with-sandbox-client-secret
PAYPAL_SANDBOX_WEBHOOK_ID=replace-with-sandbox-webhook-id
PAYPAL_LIVE_CLIENT_ID=replace-with-live-client-id
PAYPAL_LIVE_CLIENT_SECRET=replace-with-live-client-secret
PAYPAL_LIVE_WEBHOOK_ID=replace-with-live-webhook-id
PAYPAL_REQUEST_TIMEOUT_MS=10000

# Public application URLs. Register PAYPAL_WEBHOOK_URL in the matching PayPal app.
CLIENT_URL=https://your-store.example
PAYPAL_WEBHOOK_URL=https://your-api.example/api/v1/order/paypal-webhook
